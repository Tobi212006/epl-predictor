# GEMINI_API_KEY: Optional (not used for match probability modeling; probabilities run in Python)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FOOTBALL_DATA_API_KEY: Optional API token from https://www.football-data.org/
# When provided with DATA_PROVIDER="football-data", live EPL fixtures/standings/results sync automatically.
# When omitted, the app runs in explicitly labeled synthetic Demo Mode for the 2026-27 season.
FOOTBALL_DATA_API_KEY=""

# DATA_PROVIDER: "auto" | "football-data" | "openfootball" | "demo"
DATA_PROVIDER="auto"

# DATABASE_PATH: SQLite database file path (or Postgres URI when using Docker Compose FastAPI)
DATABASE_PATH="./data/epl_tactical.db"

# ADMIN_API_TOKEN: Optional bearer token protecting tactical snapshot edits and manual data sync endpoints
ADMIN_API_TOKEN=""
